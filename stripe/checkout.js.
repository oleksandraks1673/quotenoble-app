const {stripe,auth,customer,error}=require('./_common');
module.exports=async(req,res)=>{if(req.method!=='POST')return res.status(405).end();try{const user=await auth(req),st=stripe();const plan=req.body?.plan;const id=plan==='monthly'?process.env.STRIPE_PRICE_MONTHLY:plan==='yearly'?process.env.STRIPE_PRICE_YEARLY:null;if(!id)return res.status(400).json({error:'Invalid subscription plan'});const price=await st.prices.retrieve(id);if(!price.active||price.currency!=='cad'||price.type!=='recurring'||price.unit_amount!==(plan==='monthly'?1499:19999)||price.recurring.interval!==(plan==='monthly'?'month':'year'))throw Error('Stripe price configuration mismatch');const c=await customer(st,user,true);const active=await st.subscriptions.list({customer:c.id,status:'all',limit:30});if(active.data.some(s=>['active','trialing','past_due'].includes(s.status)))return res.status(409).json({error:'Subscription already exists. Use Manage billing.'});const session=await st.checkout.sessions.create({mode:'subscription',customer:c.id,line_items:[{price:id,quantity:1}],client_reference_id:user.id,success_url:'https://www.quotenoble.com/?billing=success',cancel_url:'https://www.quotenoble.com/?billing=cancelled',subscription_data:{metadata:{qn_user_id:user.id}}});res.json({url:session.url});}catch(e){error(res,e)}};
